# Required in production; use a long random value.
FLASK_SECRET_KEY=replace-with-a-random-secret
# Optional: point this at a persistent volume when deploying the app.
APP_DATA_DIR=
PUBLIC_BASE_URL=http://127.0.0.1:5000
FLASK_HTTPS_ONLY=0

# SMTP email verification (Gmail: smtp.gmail.com, port 587, TLS enabled).
# For Gmail, MAIL_PASSWORD must be an App Password, not your regular password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-address@gmail.com

# Google Cloud OAuth 2.0 Web application credentials.
# Register http://127.0.0.1:5000/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# RAG retrieval tuning (reranker loads its model on the first relevant question).
RAG_CANDIDATE_POOL=60
RAG_RERANK_CANDIDATES=40
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RAG_MIN_SIMILARITY=0.23
RAG_EMBED_BATCH_SIZE=64
